// O.1: the room server. It holds room data and relays WebRTC connection messages; no game data ever reaches it.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "soulsilver-lobby",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "DIRECTORY", "class_name": "Directory" }
    ]
  },
  // SQLite-backed Durable Objects are the ones the free plan offers.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room", "Directory"] }],
  "observability": { "enabled": true }
}
