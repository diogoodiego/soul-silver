{
  "name": "@soulsilver/app",
  "productName": "SoulSilver Desktop",
  "version": "0.5.0",
  "description": "SoulSilver Desktop",
  "author": "SoulSilver Desktop",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
