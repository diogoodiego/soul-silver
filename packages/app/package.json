    "@tailwindcss/vite": "^4.3.3",
    "@types/ws": "^8.18.2",
    "electron": "45.0.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5",
    "ws": "^8.22.0"
  }
}
